    "role": "backend-plugin-module"
  },
  "configSchema": "config.d.ts",
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.9.2",
    "@backstage/config": "^1.3.8",
    "@backstage/plugin-scaffolder-node": "^0.13.4",
    "@backstage/types": "^1.2.2",
    "axios": "^1.18.1"
  },
  "description": "A Webex scaffolding module for @backstage/plugin-scaffolder-backend",
  "devDependencies": {
    "@backstage/cli": "^0.36.3",
    "@backstage/cli-defaults": "^0.1.3",
    "@backstage/plugin-scaffolder-node-test-utils": "^0.3.12",
    "@jest/environment-jsdom-abstract": "^30.4.1",
    "@spotify/prettier-config": "^15.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^18.3.31",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.1.0",
    "prettier": "^2.8.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "config.d.ts",
    "!**/*.json",
    "!**/*.test.*",
    "!**/*.tsbuildinfo",
    "!yarn.lock",
    "catalog-info.yaml",
    "CHANGELOG.md",
    "README.md"
  ],
  "keywords": [
    "backstage",
    "cisco",
    "incoming webhooks",
    "scaffolder",
    "webex"
  ],
  "license": "Apache-2.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "main": "src/index.ts",
  "name": "@coderrob/backstage-plugin-scaffolder-backend-module-webex",
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "prettier": "@spotify/prettier-config",
  "private": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "directory": ".",
    "type": "git"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "branches": 95,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    }
  },
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "lint:fix": "yarn prettier . --write",
    "postpack": "backstage-cli package postpack",
    "prepack": "backstage-cli package prepack",
    "prepare": "husky",
    "prettier:check": "prettier --check .",
    "start": "backstage-cli package start",
    "test": "backstage-cli package test",
    "test:coverage": "backstage-cli package test --coverage --runInBand",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false"
  },
  "types": "src/index.ts",
  "version": "1.0.4"
}
