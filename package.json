{
  "author": "Robert Lindley <rob@coderrob.com> (https://coderrob.com)",
  "backstage": {
    "pluginId": "scaffolder",
    "pluginPackage": "@backstage/plugin-scaffolder-backend",
    "role": "backend-plugin-module"
  },
  "configSchema": "config.d.ts",
  "dependencies": {
    "@backstage/backend-plugin-api": "^1.9.3",
    "@backstage/config": "^1.3.8",
    "@backstage/plugin-scaffolder-node": "^0.13.5",
    "@backstage/types": "^1.2.2",
    "axios": "^1.18.1"
  },
  "description": "A Webex scaffolding module for @backstage/plugin-scaffolder-backend",
  "devDependencies": {
    "@backstage/cli": "^0.36.4",
    "@backstage/cli-defaults": "^0.1.4",
    "@jest/environment-jsdom-abstract": "^30.4.1",
    "@spotify/prettier-config": "^15.0.0",
    "@types/jest": "^30.0.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jsdom": "^27.4.0",
    "lint-staged": "^17.1.0",
    "prettier": "^2.8.8",
    "publint": "^0.3.21",
    "typescript": "~5.9.3",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/index.cjs.js",
    "dist/index.d.ts",
    "dist/module.cjs.js",
    "dist/actions/sendWebhooksMessageAction.cjs.js",
    "dist/contracts.cjs.js",
    "dist/config/readWebexActionOptions.cjs.js",
    "dist/webex/incomingWebhook.cjs.js",
    "dist/webex/sendWebhookMessage.cjs.js",
    "/config.d.ts",
    "/catalog-info.yaml",
    "/CHANGELOG.md",
    "/README.md"
  ],
  "keywords": [
    "backstage",
    "cisco",
    "incoming webhooks",
    "scaffolder",
    "webex"
  ],
  "license": "Apache-2.0",
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "main": "src/index.ts",
  "name": "@coderrob/backstage-plugin-scaffolder-backend-module-webex",
  "packageManager": "yarn@4.8.1",
  "prettier": "@spotify/prettier-config",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "directory": ".",
    "type": "git"
  },
  "resolutions": {
    "adm-zip": "0.6.0"
  },
  "jest": {
    "coverageThreshold": {
      "global": {
        "branches": 95,
        "functions": 95,
        "lines": 95,
        "statements": 95
      }
    }
  },
  "scripts": {
    "audit": "yarn npm audit --recursive --severity high",
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "backstage-cli package lint",
    "lint:fix": "yarn prettier . --write",
    "postpack": "backstage-cli package postpack",
    "prepack": "node scripts/package/prepack.mjs",
    "prepare": "husky",
    "prettier:check": "prettier --check .",
    "publint": "node scripts/package/publint.mjs",
    "start": "backstage-cli package start",
    "test": "backstage-cli package test --no-watch",
    "test:coverage": "backstage-cli package test --coverage --runInBand",
    "test:leaks": "backstage-cli package test --no-watch --runInBand --detectLeaks --detectOpenHandles",
    "test:watch": "backstage-cli package test --watch",
    "tsc": "tsc",
    "tsc:full": "tsc --skipLibCheck false --incremental false"
  },
  "type": "commonjs",
  "types": "src/index.ts",
  "version": "1.1.0"
}
